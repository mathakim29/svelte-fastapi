{
  // Hide from File Explorer
  "files.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/.git": true
  },

  // Hide from Search & Quick Open (Ctrl+P / Cmd+P)
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true
  }
}